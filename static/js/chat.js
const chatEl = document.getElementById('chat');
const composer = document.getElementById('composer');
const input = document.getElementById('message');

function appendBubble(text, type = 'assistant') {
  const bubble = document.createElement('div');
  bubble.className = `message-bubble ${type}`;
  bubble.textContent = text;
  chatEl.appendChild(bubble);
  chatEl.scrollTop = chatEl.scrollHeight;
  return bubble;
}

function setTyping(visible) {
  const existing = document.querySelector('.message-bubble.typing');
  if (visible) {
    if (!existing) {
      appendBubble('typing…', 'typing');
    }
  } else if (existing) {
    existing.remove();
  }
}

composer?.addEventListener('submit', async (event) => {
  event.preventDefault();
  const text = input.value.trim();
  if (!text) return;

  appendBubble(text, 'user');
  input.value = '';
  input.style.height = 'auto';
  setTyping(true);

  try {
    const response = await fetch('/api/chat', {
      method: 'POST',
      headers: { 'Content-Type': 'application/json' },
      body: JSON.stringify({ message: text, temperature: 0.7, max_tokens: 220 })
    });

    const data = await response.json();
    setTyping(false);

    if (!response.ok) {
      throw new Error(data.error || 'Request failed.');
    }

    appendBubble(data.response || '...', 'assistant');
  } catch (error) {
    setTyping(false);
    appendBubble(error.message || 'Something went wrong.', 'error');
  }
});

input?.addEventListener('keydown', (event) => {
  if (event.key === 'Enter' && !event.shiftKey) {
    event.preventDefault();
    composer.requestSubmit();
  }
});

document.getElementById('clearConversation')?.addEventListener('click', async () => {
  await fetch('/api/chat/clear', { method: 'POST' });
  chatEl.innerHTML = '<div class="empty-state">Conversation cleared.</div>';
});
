* {
  box-sizing: border-box;
}

:root {
  --bg: #0f172a;
  --panel: #111827;
  --panel-strong: #1f2937;
  --card: #1b2331;
  --muted: #94a3b8;
  --text: #e5e7eb;
  --primary: #7c9cff;
  --primary-strong: #5b7de8;
  --danger: #ef4444;
  --bubble-user: #4258d1;
  --bubble-assistant: #1f2937;
  --border: #334155;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
}

html, body {
  min-height: 100%;
}

.shell {
  max-width: 960px;
  margin: 0 auto;
  padding: 22px 18px 40px;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.narrow-shell {
  max-width: 700px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}

h1 {
  margin: 0;
  font-size: 2rem;
}

nav {
  display: flex;
  gap: 12px;
}

nav a, a {
  color: var(--primary);
  text-decoration: none;
}

.status-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  background: rgba(31, 41, 55, 0.9);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 14px;
  color: var(--muted);
}

.chat-panel {
  flex: 1;
  background: rgba(17, 24, 39, 0.95);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
  overflow: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 360px;
}

.message-bubble {
  max-width: 80%;
  padding: 12px 15px;
  border-radius: 14px;
  line-height: 1.45;
  white-space: pre-wrap;
  animation: fadeIn 0.18s ease;
}

.message-bubble.user {
  align-self: flex-end;
  background: var(--bubble-user);
  border-bottom-right-radius: 4px;
}

.message-bubble.assistant {
  align-self: flex-start;
  background: var(--bubble-assistant);
  border-bottom-left-radius: 4px;
}

.message-bubble.typing {
  max-width: 110px;
  opacity: 0.7;
  background: var(--bubble-assistant);
}

.message-bubble.error {
  align-self: center;
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid var(--danger);
}

.empty-state {
  margin: auto;
  color: var(--muted);
}

.composer {
  display: flex;
  gap: 10px;
}

textarea, input, select, button {
  font: inherit;
}

textarea, input, select {
  width: 100%;
  background: rgba(17, 24, 39, 0.9);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 13px;
}

textarea {
  min-height: 52px;
  resize: vertical;
}

button {
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 10px;
  padding: 12px 18px;
  cursor: pointer;
}

button:hover {
  background: var(--primary-strong);
}

.secondary-button {
  background: rgba(31, 41, 55, 0.9);
}

.danger-button {
  background: var(--danger);
}

.hidden {
  display: none !important;
}

.panel {
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px;
}

.message-preview {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px;
  white-space: pre-wrap;
  margin: 12px 0;
  max-height: 260px;
  overflow: auto;
  color: #dbeafe;
}

.stack-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
}

.settings-grid label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: var(--muted);
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.error-box {
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 10px;
  padding: 12px 14px;
  color: #fecaca;
}

.muted {
  color: var(--muted);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(5px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
